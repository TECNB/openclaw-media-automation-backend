# ==============================================
# OpenClaw Media Automation - Configuration Template
# 使用方法: 复制此文件为 .env 并填入实际值
# ==============================================

# Sonarr Configuration
# Sonarr 服务的 IP 地址 (例如: 127.0.0.1 或 局域网IP)
SONARR_HOST=127.0.0.1
# Sonarr Web 端口 (默认: 8989)
SONARR_PORT=8989
# 在 Sonarr 设置 -> 一般 -> Security 中获取
SONARR_API_KEY=your_sonarr_api_key_here

# SSH / Pikpak Service Configuration
# 运行 Pikpak Docker 容器的目标服务器 IP
SSH_HOST=127.0.0.1
# SSH 端口 (默认: 22)
SSH_PORT=22
# SSH 用户名
SSH_USER=root
# SSH 密码 (建议使用密钥认证，此处仅为示例)
SSH_PASS=your_ssh_password_here
# Pikpak Docker compose logs 所在的目录路径
SSH_TARGET_DIR=/root/docker_pikpak